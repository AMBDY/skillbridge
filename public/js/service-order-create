document.addEventListener('DOMContentLoaded', async () => {
  if (!Auth.isLoggedIn()) return location.href = '/signin.html';
  const id = new URLSearchParams(location.search).get('service'); const root = document.getElementById('serviceOrderCreate'); const service = await API.get(`/marketplace/listing/service/${id}`).catch(() => null);
  if (!service) { root.innerHTML = '<p>Service not found.</p>'; return; }
  const fields = Array.isArray(service.requirements_schema) ? service.requirements_schema : [];
  root.innerHTML = `<h1 class="section-title">Order ${service.title}</h1><p class="section-sub">Send your project brief. The freelancer reviews it before secure payment is requested.</p><form id="briefForm" class="card"><div class="card-body"><div class="form-group"><label class="form-label">Project brief *</label><textarea name="brief" class="form-textarea" required placeholder="Describe exactly what you need."></textarea></div>${fields.map((field, i) => `<div class="form-group"><label class="form-label">${field.label || field.name || `Requirement ${i + 1}`}${field.required ? ' *' : ''}</label><input class="form-input requirement" data-key="${field.key || field.name || `field_${i + 1}`}" ${field.required ? 'required' : ''}></div>`).join('')}<div class="form-group"><label class="form-label">Reference files (optional)</label><input class="form-input" id="requirementFiles" type="file" multiple accept="image/*,video/*,.pdf,.zip"></div><div class="form-group"><label class="form-label">Additional note</label><textarea name="client_note" class="form-textarea"></textarea></div><button class="btn btn-gold btn-lg">Send project request</button></div></form>`;
  document.getElementById('briefForm').addEventListener('submit', async event => { event.preventDefault(); const data = Object.fromEntries(new FormData(event.target)); const requirements = { project_brief: data.brief }; document.querySelectorAll('.requirement').forEach(input => { if (input.value.trim()) requirements[input.dataset.key] = input.value.trim(); }); try { const requirementFiles = []; for (const file of document.getElementById('requirementFiles').files) requirementFiles.push(await Upload.file(file)); const order = await API.post('/digital-services/orders', { service_id: service.id, requirements, requirements_files: requirementFiles, client_note: data.client_note }); location.href = `/service-order.html?id=${order.id}`; } catch (error) { Toast.show(error.message); } });
});
